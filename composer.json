{
    "name": "stolt/lean-package-validator",
    "description": "A library and CLI for validating if a project or package has and will have lean releases.",
    "keywords": [
        "lpv",
        "project",
        "package",
        "release",
        "lean",
        "gitattributes",
        "dist",
        "validation",
        "creation",
        "formatting",
        "negated",
        "classic",
        "export-ignore",
        "cli",
        "dev"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Raphael Stolt",
            "email": "raphael.stolt@gmail.com"
        }
    ],
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0||~8.6.0",
        "laravel/agent-detector": "^2.0",
        "sebastian/diff": "^9.0||^8.0||^7.0.0||^6.0.1||^5.0||^4.0.3",
        "stolt/list-skills-command": "^1.0",
        "symfony/console": "^8.0||^7.2.1||^v5.4.8",
        "symfony/finder": "^8.0||^7.2.1||^v5.4.8"
    },
    "autoload": {
        "psr-4": {
            "Stolt\\LeanPackage\\": "src/"
        }
    },
    "type": "library",
    "minimum-stability": "stable",
    "bin": [
        "bin/lean-package-validator"
    ],
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "carthage-software/mago": true
        }
    }
}
